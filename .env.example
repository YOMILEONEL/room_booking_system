# Used by docker-compose.yml. Copy to .env and fill in real values.

# MySQL root password (also used as SPRING_DATASOURCE_PASSWORD for the backend container).
SPRING_DATASOURCE_PASSWORD=changeme

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=changeme-generate-a-long-random-secret

# Backend URL as seen by the browser.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Optional: KI-Assistent (/assistant). Leave empty to disable it (rest of the app runs fine).
OPENAI_API_KEY=

# Optional: monitoring stack (docker compose --profile monitoring up -d, see docs/monitoring.md).
# GRAFANA_ADMIN_PASSWORD=changeme
# LOKI_URL=http://loki:3100/loki/api/v1/push
