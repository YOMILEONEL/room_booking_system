# Copy to .env and fill in real values. Never commit the real .env file.

# Use the "Session pooler" connection string from Supabase (Project Settings -> Database ->
# Connection string -> JDBC), NOT "Direct connection" (IPv6-only, usually unreachable from
# Docker Desktop on Windows) and NOT "Transaction pooler" (port 6543 - doesn't support the
# prepared statements Hibernate relies on).
SPRING_DATASOURCE_URL=jdbc:postgresql://<your-supabase-host>.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.<your-project-ref>
SPRING_DATASOURCE_PASSWORD=changeme

# Must be a long, random string in real environments (min. 32 chars for HS256).
SECURITY_JWT_SECRET=changeme-generate-a-long-random-secret
SECURITY_JWT_ISSUER=bookingssystem
SECURITY_JWT_ACCESSTOKENTTLMINUTES=60

# Room photo uploads (Supabase Storage, S3-compatible). Optional - the app runs fine without
# these, only room image upload needs them. Endpoint/region come from the Supabase dashboard:
# Project Settings -> Storage -> S3 Connection. Bucket must be created there first (Storage ->
# New bucket), marked Public.
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_S3_ENDPOINT=https://<your-project-ref>.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=eu-west-1
SUPABASE_S3_BUCKET=room-images
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
